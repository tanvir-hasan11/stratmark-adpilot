Options -Indexes
RewriteEngine On

# Use public/ as the effective document root when the hosting panel only
# permits the project root as the domain root.
RewriteRule ^(?:src|config|database|bin|storage|vendor|\.git|\.harness)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env|\.env\..*|composer\.(?:json|lock)|.*\.sql|.*\.log)$ - [F,L,NC]
RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
RewriteRule ^(.*)$ public/$1 [QSA,L]
